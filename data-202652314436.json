    "components": {
        "schemas": {
            "LivroRequestDTO": {
                "type": "object",
                "properties": {
                    "titulo": {
                        "type": "string",
                        "minLength": 1
                    },
                    "isbn": {
                        "type": "string"
                    },
                    "anoPublicacao": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "genero": {
                        "type": "string"
                    },
                    "autorId": {
                        "type": "integer",
                        "format": "int64"
                    }
                },
                "required": [
                    "anoPublicacao",
                    "autorId",
                    "genero",
                    "isbn",
                    "titulo"
                ]
            },
            "LivroResponseDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "titulo": {
                        "type": "string"
                    },
                    "isbn": {
                        "type": "string"
                    },
                    "anoPublicacao": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "genero": {
                        "type": "string"
                    },
                    "idAutor": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "autorNome": {
                        "type": "string"
                    }
                }
            },
            "AutorRequestDTO": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string"
                    },
                    "nacionalidade": {
                        "type": "string"
                    },
                    "dataNascimento": {
                        "type": "string",
                        "format": "date"
                    }
                }
            },
            "AutorResponseDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "nacionalidade": {
                        "type": "string"
                    },
                    "dataNascimento": {
                        "type": "string",
                        "format": "date"
                    }
                }
            }
        }
    }
}